      "parameters": {
        "jsCode": "const trigger = $json;\nconst chatId = trigger.message.chat.id;\nconst texto = (trigger.message.text || '').trim();\n\nfunction filaInvalida(motivo) {\n  return [{ json: { valido: false, chat_id: chatId, motivo, canal: 'texto' } }];\n}\n\nconst partes = texto.split(',').map(p => p.trim()).filter(p => p.length > 0);\nif (partes.length < 4) {\n  return filaInvalida('Formato de texto no reconocido (se esperan 4 datos separados por coma: proveedor, producto, cantidad, precio)');\n}\n\nconst [proveedor, producto, cantidadStr, precioStr] = partes;\nconst cantidad = Number(cantidadStr.replace(/[^0-9.]/g, ''));\nconst precio = Number(precioStr.replace(/[^0-9.]/g, ''));\n\nif (!proveedor || !producto || !(cantidad > 0) || !(precio > 0)) {\n  return filaInvalida('Cantidad o precio no son numeros validos, o falta proveedor/producto');\n}\n\nconst hoy = new Date().toISOString().slice(0, 10);\n\nreturn [{\n  json: {\n    valido: true,\n    chat_id: chatId,\n    Fecha: hoy,\n    Proveedor: proveedor,\n    Producto: producto,\n    Cantidad: cantidad,\n    'Precio Unitario': precio,\n    Total: cantidad * precio,\n    'Canal (foto/texto)': 'texto',\n    'Con boleta (Si/No)': 'No',\n    'Link foto/boleta': ''\n  }\n}];"
      },
