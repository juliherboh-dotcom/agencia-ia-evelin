      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst chatId = $('Preparar body Claude').first().json.chat_id;\n\ntry {\n  const text = resp.content[0].text.replace(/```json|```/g, '').trim();\n  const obj = JSON.parse(text);\n  return [{ json: { ok: true, chat_id: chatId, ...obj } }];\n} catch (e) {\n  return [{ json: { ok: false, err: e.message, chat_id: chatId } }];\n}"
      },
