    {
      "parameters": {
        "jsCode": "// NOTA: verificar en el editor de n8n que 'Merge foto + Drive' efectivamente combino por posicion\n// (un solo item con datos de Claude + un solo item con datos de Drive). Si n8n trae mas de un input\n// por rama, ajustar el modo del nodo Merge antes de activar (ver n8n_estandares.md).\nconst claude = $('Parsear respuesta Claude').first().json;\nconst drive = $('Subir foto a Drive').first().json;\nconst chatId = claude.chat_id;\n\nconst driveLink = drive.webViewLink || drive.webContentLink || '';\n\nfunction filaInvalida(motivo) {\n  return [{ json: { valido: false, chat_id: chatId, motivo, canal: 'foto' } }];\n}\n\nif (!claude.ok) return filaInvalida('Respuesta de Claude no se pudo interpretar: ' + claude.err);\nif (claude.no_legible) return filaInvalida('Foto no legible o no es una boleta de compra');\nif (!claude.proveedor || !Array.isArray(claude.items) || claude.items.length === 0) {\n  return filaInvalida('Faltan datos clave (proveedor o items) en lo extraido');\n}\n\nconst hoy = new Date().toISOString().slice(0, 10);\nconst fecha = claude.fecha && /^\\d{4}-\\d{2}-\\d{2}$/.test(claude.fecha) ? claude.fecha : hoy;\n\nconst filas = [];\nfor (const it of claude.items) {\n  const cantidad = Number(it.cantidad);\n  const precio = Number(it.precio_unitario);\n  if (!it.producto || !(cantidad > 0) || !(precio > 0)) {\n    return filaInvalida('Item con datos incompletos o no numericos: ' + JSON.stringify(it));\n  }\n  filas.push({\n    json: {\n      valido: true,\n      chat_id: chatId,\n      Fecha: fecha,\n      Proveedor: claude.proveedor,\n      Producto: it.producto,\n      Cantidad: cantidad,\n      'Precio Unitario': precio,\n      Total: cantidad * precio,\n      'Canal (foto/texto)': 'foto',\n      'Con boleta (Si/No)': 'Si',\n      'Link foto/boleta': driveLink\n    }\n  });\n}\nreturn filas;"
      },
