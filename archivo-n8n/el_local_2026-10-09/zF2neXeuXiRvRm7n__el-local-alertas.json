    {
      "parameters": {
        "jsCode": "const trigger = $('Telegram Trigger').first().json;\nconst chatId = trigger.message.chat.id;\n\nconst binaryKeys = Object.keys($input.first().binary || {});\nconst binaryProp = binaryKeys[0] || 'data';\nconst buffer = await this.helpers.getBinaryDataBuffer(0, binaryProp);\nconst b64 = buffer.toString('base64');\n\nconst prompt = `Analiza esta foto de una boleta o factura de compra a proveedor para un almacen/local (El Local). Devolve SOLO un JSON con esta forma exacta, sin texto extra ni markdown:\n{\n  \"no_legible\": false,\n  \"proveedor\": \"string\",\n  \"fecha\": \"YYYY-MM-DD o vacio si no se lee con confianza\",\n  \"items\": [\n    { \"producto\": \"string\", \"cantidad\": number, \"precio_unitario\": number }\n  ]\n}\nSi la imagen no es una boleta/factura de compra, esta borrosa, o no podes leer con confianza el proveedor y al menos un producto con cantidad y precio unitario, responde EXACTAMENTE:\n{ \"no_legible\": true }\nNo inventes ni asumas valores que no se leen claramente en la imagen. Es preferible marcar no_legible que adivinar un dato.`;\n\nconst body = {\n  model: 'claude-sonnet-5',\n  max_tokens: 1024,\n  messages: [{\n    role: 'user',\n    content: [\n      { type: 'image', source: { type: 'base64', media_type: 'image/jpeg', data: b64 } },\n      { type: 'text', text: prompt }\n    ]\n  }]\n};\n\nreturn [{ json: { chat_id: chatId, body } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1728,
        288
      ],
      "id": "59970f2b-74df-4871-bc26-8a016b57d9e7",
      "name": "Preparar body Claude"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.body }}",
        "options": {}
      },
