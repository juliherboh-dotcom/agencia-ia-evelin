      "parameters": {
        "jsCode": "const TZ = 'America/Santiago';\nconst hoy = new Date().toLocaleDateString('es-CL', { weekday: 'long', timeZone: TZ }).toLowerCase();\n\n// Solo proveedores con día confirmado por Juliana (ver flujo_actual_manual.md, 2026-07-29).\n// Confinor (ocasional), Nestlé/KR/SKULD y Dico no tienen día fijo todavía: no se pueden\n// automatizar hasta que Juliana confirme un día para cada uno (no inventar un día).\nconst PROVEEDORES_POR_DIA = {\n  'martes': ['Carozzi', 'Arcor'],\n  'miércoles': ['Carozzi']\n};\n\nconst proveedoresHoy = PROVEEDORES_POR_DIA[hoy] || [];\nconst hayPedidoHoy = proveedoresHoy.length > 0;\nconst mensaje = hayPedidoHoy\n  ? `📦 Hoy (${hoy}) toca pedido a: ${proveedoresHoy.join(', ')}`\n  : '';\n\nreturn [{ json: {\n  dia: hoy,\n  proveedores: proveedoresHoy,\n  hay_pedido_hoy: hayPedidoHoy,\n  mensaje\n} }];"
      },
