    {
      "parameters": {
        "jsCode": "const TZ = 'America/Santiago';\n\nfunction fechaLocalISO(date, timeZone) {\n  const parts = new Intl.DateTimeFormat('en-CA', {\n    timeZone,\n    year: 'numeric',\n    month: '2-digit',\n    day: '2-digit'\n  }).formatToParts(date);\n  const byType = Object.fromEntries(parts.map(p => [p.type, p.value]));\n  return `${byType.year}-${byType.month}-${byType.day}`;\n}\n\nfunction normalizarTexto(valor) {\n  return (valor || '')\n    .toString()\n    .trim()\n    .toLowerCase()\n    .normalize('NFD')\n    .replace(/[\\u0300-\\u036f]/g, '');\n}\n\nconst hoyChileStr = fechaLocalISO(new Date(), TZ);\nconst [year, month, day] = hoyChileStr.split('-').map(Number);\nconst manana = new Date(Date.UTC(year, month - 1, day + 1, 12));\n// Formato YYYY-MM-DD, igual al que ya usa la hoja COMPRAS en la columna Fecha (ver fila real\n// del 2026-06-02). Se asume que Juliana carga \"Vencimiento\" en el mismo formato al llenar\n// GASTOS_OBLIGACIONES a mano - declarado explícito, no viene de un spec exacto de ella.\nconst mananaStr = fechaLocalISO(manana, TZ);\n\nconst filas = $input.all().map(i => i.json);\n\nconst pagosManana = filas.filter(f => {\n  const vencimiento = (f['Vencimiento'] || '').toString().trim();\n  const pagado = normalizarTexto(f['Pagado (Si/No)']);\n  return vencimiento === mananaStr && pagado !== 'si';\n});\n\nconst lineas = pagosManana\n  .map(p => `- ${p['Concepto']}: $${p['Monto']} (vence ${p['Vencimiento']})`)\n  .join('\\n');\nconst hayPagosManana = pagosManana.length > 0;\nconst mensaje = hayPagosManana\n  ? `⚠️ Pagos que vencen mañana (${mananaStr}):\\n${lineas}`\n  : '';\n\nreturn [{ json: {\n  fecha_alerta: mananaStr,\n  pagos: pagosManana,\n  hay_pagos_manana: hayPagosManana,\n  mensaje\n} }];"
      },
